{
  "name": "chumthesizer",
  "version": "0.1.0",
  "private": true,
  "description": "chumthesizer — a tactile groovebox you play with three real devices: an Apple Magic Trackpad 2 (multi-instrument surface), an Ulanzi D100H dial, and an Elgato Stream Deck Pedal. Multi-instrument trackpad (Synth / Keys / Drums / Sample), a robust looper (record, overdub, mute, stack, half/double speed), and a reactive screen. Purity-Ring-leaning sound palette.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5175",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "app": "dotnet build trackpad-bridge/TrackpadBridge.csproj -c Release -v quiet && npm run sync:plugin && npm run build && electron .",
    "setup:trackpad": "dotnet build trackpad-bridge/TrackpadBridge.csproj -c Release",
    "setup:plugin": "npm --prefix plugins/ulanzi-plugin/com.ulanzi.trackpadsynth.ulanziPlugin install",
    "sync:plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-plugin.ps1",
    "install:plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-plugin.ps1",
    "pack:plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-plugin.ps1",
    "setup:sd-plugin": "npm --prefix plugins/streamdeck-plugin/com.chum.chumthesizer.sdPlugin install",
    "install:sd-plugin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sd-plugin.ps1",
    "test:bridge": "node scripts/smoke-bridge.mjs",
    "trackpad": "dotnet run --project trackpad-bridge -c Release",
    "gestures:off": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/touchpad-gestures.ps1 off",
    "gestures:on": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/touchpad-gestures.ps1 on",
    "gestures:toggle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/touchpad-gestures.ps1 toggle"
  },
  "devDependencies": {
    "@types/animejs": "^3.1.13",
    "@types/w3c-web-hid": "^1.0.6",
    "@types/webmidi": "^2.1.0",
    "electron": "^33.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "animejs": "^3.2.2"
  }
}
